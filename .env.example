# ============================================================
# medagent-core — Environment Configuration Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM API Keys ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
KIMI_API_KEY=...

# --- LLM Model Overrides (optional) ---
# Defaults track the current model stack, verified 2026-11-12 (see CONFIGURATION.md).
# Also documented: gpt-6-astra, claude-fable-5-2 (demanding reasoning), gemini-4-carbon
# (strongest Gemini), gemini-4-hydrogen (lower-latency Gemini), kimi-k3.1-pro-highspeed.
# Claude never receives sampling parameters, and models that fix them (GPT-5+/o-series,
# Gemini 3+/4, Kimi K3) never receive temperature.
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-opus-5-5
GOOGLE_MODEL=gemini-4-argon
KIMI_MODEL=kimi-k3.1-pro
# Kimi endpoint: platform.kimi.ai keys use api.moonshot.ai; mainland China accounts use api.moonshot.cn
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Completion budget per LLM call, including reasoning/thinking tokens
LLM_MAX_OUTPUT_TOKENS=32768

# --- PubMed / NCBI ---
# Register at: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=
PUBMED_EMAIL=your-email@example.com

# --- OpenFDA ---
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/audit.db
# For production Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/medagent

# --- Agent Behaviour ---
# Minimum confidence before ESCALATE is triggered (0.0 – 1.0)
AGENT_CONFIDENCE_THRESHOLD=0.6
# Hard wall-clock cap per agent run in seconds
AGENT_TOTAL_TIMEOUT_SECONDS=120
AGENT_ENTITY_EXTRACTION_TIMEOUT=10
AGENT_RETRIEVAL_TIMEOUT=20
AGENT_REASONING_TIMEOUT=90

# --- Knowledge Base ---
# Path to UMLS/BioWordVec embedding file (optional local KB)
KB_EMBEDDING_PATH=./data/biowordvec_pubmed_mesh_200d.bin
KB_INDEX_PATH=./data/kb_index/

# --- API Server ---
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO

# --- Security ---
# Salt for PII hashing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_HASH_SALT=change-me-to-a-random-hex-string

# --- CDS Hooks (HL7 CDS Hooks 2.0, /cds-services) ---
# Opt-in CORS allow-list for browser-based CDS clients, comma-separated origins
# (scheme://host[:port], no wildcard). Empty = no CORS headers on /cds-services.
# Example for the public sandbox: https://sandbox.cds-hooks.org
# The service does not verify CDS Hooks JWTs: keep it behind an authenticating gateway.
MEDAGENT_CDS_HOOKS_CORS_ORIGINS=

# --- Evaluation ---
MEDQA_DATA_PATH=./data/medqa_usmle_4_options_test.jsonl
DRUGBANK_TEST_PATH=./data/drugbank_interactions_test.json
EVAL_MAX_SAMPLES=100
